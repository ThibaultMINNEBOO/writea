{
  "name": "@writea/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply writea --local",
    "db:migrate:remote": "wrangler d1 migrations apply writea --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@writea/shared": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "wrangler": "^4.144.0"
  }
}
